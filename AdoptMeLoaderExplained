local SCRIPT_URL = "https://raw.githubusercontent.com/Amivictim/adoptmefarm/refs/heads/main/AdoptMeFarm_public.lua"
getgenv().AdoptMeFarmLoaderInfo = { Url = SCRIPT_URL }

local ok, source = pcall(function()
    return game:HttpGet(SCRIPT_URL .. "?nocache=" .. tostring(os.time()))
end)
if not (ok and type(source) == "string" and #source > 5000
    and string.find(string.sub(source, 1, 300), "AdoptMe Farm  v", 1, true)) then
    warn("[Loader] Download failed or it is not AdoptMe Farm: check SCRIPT_URL")
    return
end
local program, compileError = loadstring(source)
if not program then
    warn("[Loader] Syntax error in the download: " .. tostring(compileError))
    return
end
program()
